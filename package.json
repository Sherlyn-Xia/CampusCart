{
  "name": "campuscart-hacku-mvp",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "CampusCart — a verifiable student-benefit checkout agent sandbox for HacKU.",
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
