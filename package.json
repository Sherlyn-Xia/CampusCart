  },
  "engines": {
    "node": ">=22 <23"
  },
  "dependencies": {
    "@langchain/core": "^1.2.14",
    "@langchain/langgraph": "^1.4.18",
    "@langchain/openai": "^1.6.2",
    "dotenv": "^18.0.5",
    "langchain": "^1.5.15",
    "openai": "^7.27.0",
    "zod": "^4.6.5"
  }
}
