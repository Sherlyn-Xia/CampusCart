# Copy this file to `.env` and fill in your own values. Never commit `.env`
# (it is listed in .gitignore) and never paste a real key into an issue or chat.

# --- LLM (optional) ---------------------------------------------------------
# Leave OPENAI_API_KEY empty to run the tested deterministic LangGraph fallback.
# Any OpenAI-compatible provider works.
OPENAI_API_KEY=
# Model name sent to the provider. Choose one your provider offers.
CAMPUSCART_AGENT_MODEL=gpt-4o-mini
# Leave empty for api.openai.com. For an OpenAI-compatible gateway set its base URL.
OPENAI_BASE_URL=

# --- Optional semantic RAG -------------------------------------------------
# Leave CAMPUSCART_EMBEDDING_MODEL empty to use local FTS5 + lexical retrieval only.
# Set it to a model supported by your provider to enable persistent hybrid vector retrieval.
CAMPUSCART_EMBEDDING_MODEL=
# CAMPUSCART_EMBEDDING_DIMENSIONS=1536
# CAMPUSCART_EMBEDDING_API_KEY=       # defaults to OPENAI_API_KEY
# CAMPUSCART_EMBEDDING_BASE_URL=      # defaults to OPENAI_BASE_URL

# Example for DeepSeek (uncomment all three and put your own key in the first line):
# OPENAI_API_KEY=your-deepseek-key
# OPENAI_BASE_URL=https://api.deepseek.com
# CAMPUSCART_AGENT_MODEL=deepseek-chat

# --- Server (optional) ------------------------------------------------------
# PORT=3000
# HOST=127.0.0.1
# Persistent Agent runs, LangGraph checkpoints, transactions and payment sessions.
# CAMPUSCART_DB_PATH=data/campuscart.sqlite
# Required only for the isolated operator API under /api/v1/operator/.
# Use a long random value in real deployments; never expose it to the shopping Agent.
# CAMPUSCART_OPERATOR_API_KEY=replace-with-at-least-32-random-characters
# CAMPUSCART_OPERATOR_ID=sandbox-operator
# Only when the front end is served from a different origin (e.g. a Vite dev server).
# CORS_ORIGIN=http://localhost:5173
